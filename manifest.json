{
  "manifest_version": 3,
  "name": "Anubis",
  "version": "1.0.0",
  "description": "Weighs every post on X against the feather and exiles the AI-written ones to the Duat. Runs fully offline: your feed never leaves your machine.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/constants.js",
        "src/dom-text.js",
        "src/sites/x.js",
        "src/stats-panel.js",
        "src/content/config.js",
        "src/content/state.js",
        "src/content/results.js",
        "src/content/chip.js",
        "src/content/animation.js",
        "src/content/scheduler.js"
      ],
      "css": [
        "src/content.css",
        "src/sites/x.css",
        "src/stats-panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
